<odoo>
    <data>
        <record id="inherit_view_purchase_order_form" model="ir.ui.view">
             <field name="name">inherit.views.purchase.order.form</field>
             <field name="model">purchase.order</field>
             <field name="inherit_id" ref="purchase.purchase_order_form"/>
             <field name="arch" type="xml">
                 <xpath expr="//button[@name='action_rfq_send']" position="after">
                    <button name="sign_document" invisible="state == 'draft'" string="Signer" type="object" class="oe_highlight"/>
                 </xpath>
            </field>
        </record>
    </data>
</odoo>